---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/layout/home/hero/Hero.astro';
import GalleryBento from '../components/layout/home/gallery-bento/GalleryBento.astro';
import Blockquote from '../components/layout/home/blockquote/Blockquote.astro';
import TextTwoMedia from '../components/layout/home/text-two-media/TextTwoMedia.astro';
import FeaturedBlogs from '../components/layout/home/featured-blogs/FeaturedBlogs.astro';
import FeaturedRecipes from '../components/layout/home/featured-recipes/FeaturedRecipes.astro';
import MusicShout from '../components/layout/home/music-shout/MusicShout.astro';
import GamedevShout from '../components/layout/home/gamedev-shout/GamedevShout.astro';
---

<Layout classes={['home']}>
  <Hero />

  <GalleryBento />

  <Blockquote
		quote="the camera is an instrument that teaches people how to see without a camera"
		author="Dorothea Lange, cinematographer"
	/>

  <TextTwoMedia />

  <FeaturedBlogs />

  <FeaturedRecipes />

  <MusicShout />

  <GamedevShout /> 
</Layout>
