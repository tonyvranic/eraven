---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SubpageHero from '../../components/utils/subpage-hero/SubpageHero.astro';
import TextImage from '../../components/subpages/text-image/TextImage.astro';
import Blockquote from '../../components/layout/home/blockquote/Blockquote.astro';
import ImageWithText from '../../components/subpages/image-with-text/ImageWithText.astro';
import AbstractText from '../../components/subpages/abstract-text/AbstractText.astro';
import ClosingThought from '../../components/subpages/closing-thought/ClosingThought.astro';
import AbstractText2 from '../../components/subpages/abstract-text-2/AbstractText2.astro';
import MusicPlayer from '../../components/subpages/music-player/MusicPlayer.astro';
import RecipeDetail from '../../components/subpages/recipe-detail/RecipeDetail.astro';
import Accordion from '../../components/subpages/accordion/Accordion.astro';

/* Computed */
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const data = post.data;

// Convert from Date to 'DD.MM.YYYY.'
const dateCreated = new Date(data.dateCreated).toLocaleDateString('hr-HR').split(' ').join('');
const dateUpdated = new Date(data.lastEditDate).toLocaleDateString('hr-HR').split(' ').join('');
---


{/* Html */}
<Layout classes={['blog', 'secondary-styling']}>
  <SubpageHero
    bannerSrc={data.heroImage.src}
    bannerAlt={data.heroImage.alt}
    title={data.title}
    subtitle={data.excerpt}
    dateCreated={dateCreated}
    dateUpdated={dateUpdated}
    tags={data.tags}
    theme="secondary"
  />

  {
    data.sections.map((section) => {
      switch (section.type) {
        case 'textImage': return (<TextImage theme="secondary" {...section} />);
        case 'imageWithText': return (<ImageWithText theme="secondary" {...section} />);
        case 'abstractText': return (<AbstractText theme="secondary" {...section} />);
        case 'abstractText2': return (<AbstractText2 theme="secondary" {...section} />);
        case 'blockquote': return (<Blockquote theme="secondary" {...section} />);
        case 'musicPlayer': return (<MusicPlayer theme="secondary" {...section} />);
        case 'recipeDetail': return (<RecipeDetail theme="secondary" {...section} />);
        case 'accordion': return (<Accordion theme="primary" {...section} />);
        case 'closing': return (<ClosingThought theme="secondary" {...section} />);
      }
    })
  }
</Layout>