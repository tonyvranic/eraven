---
import type { IngredientCategory, Nutrients, Servings } from './RecipeLeftColumn.types';
import RecipeLeftColumnTop from './RecipeLeftColumnTop/RecipeLeftColumnTop.astro';
import RecipeLeftColumnCenter from './RecipeLeftColumCenter/RecipeLeftColumCenter.astro';
import RecipeLeftColumnBottom from './RecipeLeftColumnBottom/RecipeLeftColumnBottom.astro';
import Flex from '../Flex.astro';


/* Props */
interface Props {
  time: string;
  complexity: string;
  servings: Servings;
  nutrients: Nutrients;
  ingredientCategories: IngredientCategory[];
}

const { 
  time,
  complexity,
  servings,
  nutrients,
  ingredientCategories
} = Astro.props;


/* Computed */
---


{/* Html */}
<Flex
  dt={{ wrap: 'nowrap', dir: 'column', gap: 'md' }}
  class:list={['recipe-left-column', 'sticky', 'rel', 'z-2']}
  data-recipe-left-column
>
  <RecipeLeftColumnTop
    time={time}
    complexity={complexity}
    class:list={['item-left', 'slice-top-right']}
  />

  <RecipeLeftColumnCenter
    servings={servings}
    nutrients={nutrients}
    classes={['item-left', 'slice-top-right']}
  />

  <RecipeLeftColumnBottom
    ingredientCategories={ingredientCategories}
    class:list={['item-left', 'slice-top-right']}
  />
</Flex>


{/* Styles */}
<style lang="scss">
  @use './RecipeLeftColumn.scss';
</style>


{/* Script */}
<script>
  import Init from './RecipeLeftColumn.ts';

  Init();
</script>