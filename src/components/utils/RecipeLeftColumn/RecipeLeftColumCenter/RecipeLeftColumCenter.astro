---
import Icon from '../../../ui/icon/Icon.astro';
import Input from '../../../ui/input/Input.astro';
import Text from '../../../ui/text/Text.astro';
import Flex from '../../Flex.astro';
import Stat from '../../stat/Stat.astro';
import type { Nutrients, Servings } from '../RecipeLeftColumn.types';

/* Props */
interface Props {
  servings: Servings;
  nutrients: Nutrients;
  classes?: string[];
}

const { 
  servings,
  nutrients,
  classes = [],
  ...rest
} = Astro.props;


/* Computed */
---


{/* Html */}
<div 
  class:list={['recipe-left-colum-center', 'rel', ...classes]}
  {...rest}
>
  <input 
    type="checkbox" name="calculator" id="calculator"
    class:list={['calculator-dd-input', 'visually-hidden']}
  >

  {/* Serving Size */}
  <div class:list={['serving-size', 'rel']}>
    <Text
      for="serving-size"
      el="label" type="label-md"
      class:list={['serving-size-label', 'primary-300', 'mb-sm']}
    >
      Serving Size
    </Text>

    <div class:list={['serving-size-normal-wrap', 'rel', 'dd', 'active']}>
      <div class:list={['o-h']}>
        <Stat
          value={servings.servingsCount.toString()}
          classes={['fw']}
        />
      </div>
    </div>

    <div class:list={['serving-size-input-wrap', 'rel', 'dd']}>
      <div class:list={['o-h']}>
        <Input
            id="serving-size"
            value={servings.servingsCount.toString()}
            type="number"
          />
      </div>
    </div>
  
    {/* Dropdown */}
    <label 
      for="calculator"
      aria-label="Toggle calculator dropdown"
      title="Toggle calculator dropdown"
      class:list={['calculator-label', 'abs']}
    >
      <Icon
        name="DownArrow"
        size={24}
        class:list={['calculator-icon']}
      />
    </label>
  </div>

  <div class:list={['dd']}>

    <Flex 
      dt={{ dir: 'column', wrap: 'nowrap', gap: 'md' }}
      class:list={['o-h']}
    >

      {/* Per serving, total */}
      <Flex
        dt={{ gap: 'md', mt: 'md' }}
      >
        <Input
          id="per-serving"
          label="Per Serving"
          value={servings.perServingWeight.toString()}
          type="number"
          suffix="g"
        />
        <Input
          id="total-serving"
          label="Total"
          value={servings.totalWeight.toString()}
          type="number"
          suffix="g"
        />
      </Flex>

      {/* Calories */}
      <Stat
        label="Calories"
        value={nutrients.calories.toString()}
        type="large"
      />

      {/* Carbs, Sugars */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Carbs"
          value={nutrients.carbs.toString()}
        />
        <Stat
          label="Sugars"
          value={nutrients.sugars.toString()}
        />
      </Flex>

      {/* Fats, Saturated Fats */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Fats"
          value={nutrients.fats.toString()}
        />
        <Stat
          label="Saturated Fats"
          value={nutrients.saturatedFats.toString()}
        />
      </Flex>

      {/* Protein, Fibers */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Protein"
          value={nutrients.protein.toString()}
        />
        <Stat
          label="Fibers"
          value={nutrients.fibers.toString()}
        />
      </Flex>

      {/* Salts */}
      <Stat
        label="Salts"
        value={nutrients.salts.toString()}
      />

    </Flex>
  </div>
</div>


{/* Styles */}
<style lang="scss">
  @use './RecipeLeftColumCenter.scss';
</style>