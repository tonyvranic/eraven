---
import Icon from '../../../ui/icon/Icon.astro';
import Input from '../../../ui/input/Input.astro';
import Text from '../../../ui/text/Text.astro';
import Flex from '../../Flex.astro';
import LabelIconButton from '../../label-icon-button/LabelIconButton.astro';
import Stat from '../../stat/Stat.astro';
import type { Nutrients, Servings } from '../RecipeLeftColumn.types';

/* Props */
interface Props {
  servings: Servings;
  nutrients: Nutrients;
  classes?: string[];
}

const { 
  servings,
  nutrients,
  classes = [],
  ...rest
} = Astro.props;


/* Computed */
let perServing = servings.totalWeight / servings.servingsCount;
// Round to 2 decimal places
perServing = Math.round(perServing * 100) / 100;
---


{/* Html */}
<div 
  class:list={['recipe-left-colum-center', 'rel', ...classes]}
  {...rest}
>
  <input 
    type="checkbox" name="calculator" id="calculator"
    class:list={['calculator-dd-input', 'visually-hidden']}
  >

  {/* Serving Size */}
  <div class:list={['serving-size', 'rel']}>

    <Flex
      dt={{ wrap: 'nowrap', align: 'center', justify: 'between' }}
      class:list={['serving-size-label-wrap', 'primary-300', 'mb-sm']}
    >
      <Text
        for="serving-size"
        el="label" type="label-md"
        class:list={['serving-size-label']}
      >
        Serving Size
      </Text>

      <LabelIconButton
        label={'Serving Size'}
        locked="Unlocked"
        lockedButtonAttributes={{ 'data-serving-size-lock-button': '' }}
      />
    </Flex>

    <div class:list={['serving-size-normal-wrap', 'rel', 'dd', 'active']}>
      <div class:list={['o-h']}>
        <Stat
          value={servings.servingsCount.toString()}
          classes={['fw']}
          valueAttributes={{ 'data-serving-size-display': '' }}
        />
      </div>
    </div>

    <div class:list={['serving-size-input-wrap', 'rel', 'dd']}>
      <div class:list={['o-h']}>
        <Input
            id="serving-size"
            value={servings.servingsCount.toString()}
            type="number"
            inputAttributes={{ 'data-serving-size-input': '' }}
          />
      </div>
    </div>

    {/* Revert Button */}
    <button 
      class:list={['revert-button', 'abs', 'error-300']}
      type="button" 
      aria-label="Revert all changes" title="Revert all changes"
    >
      <Icon
        name="Forward"
        size={24}
      />
    </button>

    {/* Dropdown */}
    <label 
      for="calculator"
      aria-label="Toggle calculator dropdown"
      title="Toggle calculator dropdown"
      class:list={['calculator-label', 'abs']}
    >
      <Icon
        name="DownArrow"
        size={24}
        class:list={['calculator-icon']}
      />
    </label>
  </div>


  {/* Dropdown */}
  <div class:list={['dd']}>
    <Flex 
      dt={{ dir: 'column', wrap: 'nowrap', gap: 'md' }}
      class:list={['o-h']}
    >

      {/* Per serving, total */}
      <Flex
        dt={{ gap: 'md', mt: 'md' }}
      >
        <Input
          id="per-serving"
          label="Per Serving"
          value={perServing.toString()}
          type="number"
          suffix="g"
          locked="Locked"
          inputAttributes={{ 'data-per-serving-input': '' }}
          lockedButtonAttributes={{ 'data-per-serving-lock-button': '' }}
        />
        <Input
          id="total-serving"
          label="Total"
          value={servings.totalWeight.toString()}
          type="number"
          suffix="g"
          locked="Unlocked"
          inputAttributes={{ 'data-total-serving-input': '' }}
          lockedButtonAttributes={{ 'data-total-serving-lock-button': '' }}
        />
      </Flex>

      {/* Calories */}
      <Stat
        label="Calories"
        value={nutrients.calories.toString()}
        type="large"
        valueAttributes={{ 'data-calories-display': '' }}
      />

      {/* Carbs, Sugars */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Carbs"
          value={nutrients.carbs.toString()}
          valueAttributes={{ 'data-carbs-display': '' }}
        />
        <Stat
          label="Sugars"
          value={nutrients.sugars.toString()}
          valueAttributes={{ 'data-sugars-display': '' }}
        />
      </Flex>

      {/* Fats, Saturated Fats */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Fats"
          value={nutrients.fats.toString()}
          valueAttributes={{ 'data-fats-display': '' }}
        />
        <Stat
          label="Saturated Fats"
          value={nutrients.saturatedFats.toString()}
          valueAttributes={{ 'data-saturated-fats-display': '' }}
        />
      </Flex>

      {/* Protein, Fibers */}
      <Flex
        dt={{ gap: 'md' }}
      >
        <Stat
          label="Protein"
          value={nutrients.protein.toString()}
          valueAttributes={{ 'data-protein-display': '' }}
        />
        <Stat
          label="Fibers"
          value={nutrients.fibers.toString()}
          valueAttributes={{ 'data-fibers-display': '' }}
        />
      </Flex>

      {/* Salts */}
      <Stat
        label="Salts"
        value={nutrients.salts.toString()}
        valueAttributes={{ 'data-salts-display': '' }}
      />

    </Flex>
  </div>
</div>


{/* Styles */}
<style lang="scss">
  @use './RecipeLeftColumCenter.scss';
</style>