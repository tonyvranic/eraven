---
import type { RecipeStep } from './Step.types';

import { numberMap } from '../../ui/icon/Icon.types';
import Text from '../../ui/text/Text.astro';
import Flex from '../Flex.astro';
import Icon from '../../ui/icon/Icon.astro';

/* Props */
interface Props {
  number: number;
  step: RecipeStep[];
}

const { 
  number,
  step,
} = Astro.props;


/* Computed */
const number0 = numberMap[Math.floor(number / 10) % 10];
const number1 = numberMap[number % 10];
---


{/* Html */}
<Flex
  dt={{ gap: 'md', wrap: 'nowrap' }}
  sm={{ gap: 'sm' }}
  xxs={{ dir: 'column', gap: 'xs' }}
  class:list={['step', 'rel']}
>
  <Text el="h3" class:list={['hidden-title', 'abs']}>Step {number}</Text>

  {/* Hidden checkbox */}
  <input 
    type="checkbox"
    name={`step-${number}-togg`} id={`step-${number}-togg`}
    class:list={['checkbox', 'visually-hidden']}
  />

  {/* Left */}
  <Flex 
  dt={{ shrink: true, align: 'start' }}
  class:list={['step-left', 'rel', 'primary-700']}
  >
    {/* 
      The label has been position at the top of the step.
      I was contemplating to add it over the text, but that would
      interfere with the ability to highlight the text.
    */}
    <label 
      aria-label={`Toggle step ${number}`}
      title={`Toggle step ${number}`}
      for={`step-${number}-togg`}
      class:list={['checkbox-label', 'abs-fw', 'z-3']}
    ></label>

    <Flex class:list={['step-active', 'abs', 'z-2', 'primary-400']}>
      <Icon name={number0} class:list={['number']} />
      <Icon name={number1} class:list={['number']} />
    </Flex>

    <Flex class:list={['step-inactive']}>
      <Icon name={number0} class:list={['number']} />
      <Icon name={number1} class:list={['number']} />
    </Flex>
  </Flex>

  {/* Right */}
  <div class:list={['step-right', 'asc']}>
    {step.map((s, index) => {
      switch(s.type) {
        case 'text':
          return <div set:html={s.content} class:list={['step-block', 'user-content']}></div>
        case 'image':
          return <Text type="display-2xl" class:list={['error']}>TODO</Text>
      }
    })}
  </div>
</Flex>


{/* Styles */}
<style lang="scss">
  @use './Step.scss';
</style>


{/* Script */}
<script>
  
</script>