---
import Text from '../../ui/text/Text.astro';
import Cell from '../Cell.astro';
import Flex from '../Flex.astro';
import Grid from '../Grid.astro';

/* Props */
interface Props {
  bannerSrc: string;
  bannerAlt: string;
  title: string;
  subtitle: string;
  dateCreated: string;
  dateUpdated: string;
  tags?: string[];

  theme: 'secondary' | 'primary';
}

const { 
  bannerSrc,
  bannerAlt,
  title,
  subtitle,
  dateCreated,
  dateUpdated,
  tags,

  theme,
} = Astro.props;


/* Computed */
const firstWordInTitle = title.split(' ')[0];
const restOfTitle = title.split(' ').slice(1).join(' ');

const heroTitleColorClass = theme === 'secondary' ? 'secondary-400' : 'primary-400';
const overlayColorClass   = theme === 'secondary' ? 'bg-secondary-400' : 'bg-primary-400';
const tagColorClass = theme === 'secondary' ? 'secondary-400' : 'primary-300';
const tagBgColorClass = theme === 'secondary' ? 'bg-secondary-700' : 'bg-primary-700';

const showDateUpdated = dateCreated !== dateUpdated;
const isSingleWordTitle = title.split(' ').length === 1;
const singleWordTitleClass = isSingleWordTitle ? 'single-word' : '';
---


{/* Html */}
<section class:list={['subpage-hero', 'rel', 'z-0']} data-subpage-hero-section>
  {/* Background */}
  <Grid md sm xxs class:list={['bg', 'z-1', 'fh', 'o-h', 'parallax-bg']}>
    <Cell
      dt={{ start: 5, span: 8 }}
      md={{ start: 6, span: 7 }}
      sm={{ start: 5, span: 8 }}
      xxs={{ start: 4, span: 9 }}
      class:list={['fh']}
    >
      <div class:list={['bg-image-wrap', 'media', 'fh']}>
        <div class:list={['bg-image', 'fh', 'rel']}>
          <div class:list={['bg-image-inner', 'fh']}>
            <img
              width="1280" height="850"
              src={bannerSrc}
              alt={bannerAlt}
            />
            <div class:list={['overlay', 'abs-fw', 'no-e', 'z-2', overlayColorClass]}></div>
            <div class:list={['overlay-darken', 'abs-fw', 'no-e', 'z-3']}></div>
          </div>
        </div>
      </div>
    </Cell>
  </Grid>

  {/* Content */}
  <Grid sm xs xxs class:list={['content-wrap', 'z-2', 'ac']}>
    <Cell
      dt={{ start: 1, span: 6 }}
      sm={{ start: 1, span: 7 }}
      xs={{ start: 1, span: 8 }}
      xxs={{ start: 1, span: 12 }}
    >
      <Text el='h1' set:html={title} aria-hidden class:list={['hidden-title', 'abs']} />

      <div class:list={['content']}>

        {/* Title */}
        <div class:list={['title', 'tr', heroTitleColorClass]}>

          {/* First Word */}
          <Text 
            el="span" type="display-2xl"
            class:list={['first-title-word', singleWordTitleClass]}
          >
            {firstWordInTitle}

            {/* Date */}
            <Text el="span" type="label-md" class:list={['date', 'abs', 'pl-4', 'light-0']}>
              {dateCreated} {showDateUpdated ? `\u00a0 — (Edit: ${dateUpdated})` : ''}
            </Text>
          </Text>

          {/* Rest of Title */}
          {restOfTitle && (
            <Text el="span" type="display-2xl" set:html={restOfTitle} />
          )}
        </div>

        {/* Subtitle */}
        <Text 
          el="p" type="body-lg"
          class:list={['subtitle', 'tr', 'pt-md', 'lg:pt-sm', 'xxs:pt-xs']}
        >
          {subtitle}
        </Text>

        {/* Tags */}
        {tags && tags.length > 0 && (
          <Flex
            dt={{ gap: 'xs', justify: 'end', mt: 'sm' }}
            xs={{ justify: 'start' }}
            class:list={['tags']}
          >
            {tags.map(tag => (
              <Text 
                el="span" type="label-md"
                class:list={['tag', tagColorClass, tagBgColorClass]}
              >
                {tag}
              </Text>
            ))}
          </Flex>
        )}
      </div>
    </Cell>
  </Grid>
</section>


{/* Styles */}
<style lang="scss">
  @use './SubpageHero.scss';
</style>


{/* Script */}
<script>
  import { queryFn } from "../../../utils/queryFn";

  const sections = document.querySelectorAll<HTMLElement>('[data-subpage-hero-section]');

  sections.forEach(section => {
    const bgEl = queryFn(section, '.parallax-bg');
    if (!bgEl) return;


    // Config
    // How far the bg should travel over the full height of the hero
    const parallaxDistancePx = 560;
    const scaleDecrAmount = 0.1;
    const rotateDeg = -25;
    const opacityDecrAmount = 0.8;


    // State
    let ticking = false;


    // Computed - Stale
    const headerHeight = document.querySelector<HTMLElement>('header')?.offsetHeight || 0;


    // Main
    update();


    // Events
    window.addEventListener('scroll', onScroll, { passive: true });


    // Functions
    function update() {
      const rect = section.getBoundingClientRect();

      // Dont update if the section is not in the viewport
      if ((Math.abs(rect.top)) > (window.innerHeight + parallaxDistancePx * 0.5)) {
        ticking = false;
        return;
      }

      // 0 = hero top at viewport top, 1 = hero has fully scrolled past
      const top = -rect.top + headerHeight;
      const height = (rect.height + parallaxDistancePx)
      const progress = Math.min(Math.max(top / height, 0), 1);

      bgEl!.style.setProperty('--parallax-y', `${progress * parallaxDistancePx}px`);
      bgEl!.style.setProperty('--parallax-scale', `${1 - (progress * scaleDecrAmount)}`);
      bgEl!.style.setProperty('--parallax-rotate', `${progress * rotateDeg}deg`);
      bgEl!.style.setProperty('--opacity', `${1 - (progress * opacityDecrAmount)}`);
      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }
  });
</script>