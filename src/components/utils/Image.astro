---
/* Props */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  offset?: string;
  class?: string;
}

const { src, alt, width, height, class: className, offset } = Astro.props;

/* Computed */
let placeholderSvg = `<svg width="${width}" height="${height}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}"></svg>`;
placeholderSvg = `data:image/svg+xml,${encodeURIComponent(placeholderSvg)}`;
---


{/* Html */}
<img
  class:list={['image', className]}
  data-offset={offset}
  src={placeholderSvg}
  data-src={src}
  data-image
  alt={alt}
  width={width}
  height={height}
  decoding="async"
/>

<noscript>
  <img
    class:list={['image', className]}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
</noscript>


{/* Script */}
<script>
  // Queries
  const imgEls = document.querySelectorAll<HTMLImageElement>('[data-image]');

  // Main
  if (!('IntersectionObserver' in window)) {
    InstantlyLoadImages();
  } else {
    // Each distinct rootMargin needs its own observer instance
    const groups = new Map<string, HTMLImageElement[]>();

    AddImagesToGroups(groups);
    IterateThroughGroups(groups);
  }


  // Functions
  function IterateThroughGroups(groups: Map<string, HTMLImageElement[]>) {
    groups.forEach((group, rootMargin) => {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;

          const imgEl = entry.target as HTMLImageElement;
          const src = imgEl.dataset.src;
          if (src) imgEl.src = src;

          obs.unobserve(imgEl);
        });
      }, { rootMargin });

      group.forEach(imgEl => observer.observe(imgEl));
    });
  }

  function AddImagesToGroups(groups: Map<string, HTMLImageElement[]>) {
    imgEls.forEach(imgEl => {
      const rootMargin = imgEl.dataset.offset || '200px';
      const group = groups.get(rootMargin) ?? [];
      group.push(imgEl);
      groups.set(rootMargin, group);
    });
  }


  // Helpers
  function InstantlyLoadImages() {
    imgEls.forEach(imgEl => {
      const src = imgEl.dataset.src;
      if (src) imgEl.src = src;
    });
  }
</script>