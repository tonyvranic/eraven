---
/* Props */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;

  offset?: string;
  multiplierOffset?: string;
  multiplier?: string;

  class?: string;
}

const { src, alt, width, height, class: className, offset, multiplierOffset, multiplier } = Astro.props;

/* Computed */
let placeholderSvg = `<svg width="${width}" height="${height}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}"></svg>`;
placeholderSvg = `data:image/svg+xml,${encodeURIComponent(placeholderSvg)}`;
---


{/* Html */}
{/* Noscript fallback */}
<div 
  class:list={['image', 'noscript-image', className]}
  style={`--src: url(${src})`}
></div>

{/* Normal lazy loaded html */}
<img
  width={width} height={height}
  class:list={['image', className]}
  data-image
  data-offset={offset}
  data-multiplier-offset={multiplierOffset}
  data-multiplier={multiplier}
  src={placeholderSvg}
  data-src={src}
  alt={alt}
  decoding="async"
/>

{/*
<noscript>
  <img
    class:list={['image', className]}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
</noscript>
 */}


{/* Script */}
<script>
  import { lazyObserve } from '../../utils/lazyObserve';

  lazyObserve<HTMLImageElement>({
    selector: '[data-image]',
    onIntersect: imgEl => {
      const src = imgEl.dataset.src;
      if (src) imgEl.src = src;
    },
  });
</script>