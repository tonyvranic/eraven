---
import Text from '../../ui/text/Text.astro';
import type { TypographyType } from '../../ui/text/Text.types';

/* Props */
interface Props {
  label?: string;
  value: string;
  type?: 'small' | 'large';
  classes?: string[];
  valueAttributes?: Record<string, any>;
}

const { 
  label,
  value,
  type = 'small',
  classes = [],
  valueAttributes = {},
} = Astro.props;


/* Computed */
const valueType: TypographyType = type === 'small' ? 'display-md' : 'display-lg';
const labelSpacingClasses = type === 'small' ? ['mb-xs'] : ['mb-sm'];
---


{/* Html */}
<div class:list={['stat', ...classes]}>
  {label && (
    <Text el="span" type="label-md" class:list={['primary-300', ...labelSpacingClasses]}>
      {label}
    </Text>
  )}
  <Text el="span" type={valueType} class:list={['light-0']} {...valueAttributes}>
    {value}
  </Text>
</div>


{/* Styles */}
<style lang="scss">
  @use './Stat.scss';
</style>