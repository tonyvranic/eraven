  /* Destructure your props here */
} = Astro.props;


/* Computed */
---


{/* Html */}
<div 
  id="reveal"
  aria-hidden inert
  style="position:fixed; top: 0; left: 0; bottom: 0; right: 0; z-index: 20;"
> 
  <div
    class:list={['bg']}
    style="position:absolute; top: 0; left: 0; bottom: 0; right: 0; z-index: 1; background-color: #131313"
  ></div>

  <div 
    class:list={['img-wrap']}
    style="position:absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; width: 360px; height: 360px;"
  >
    <img 
      width="360" height="360"
      src="/logo.svg" alt="Reveal Logo"
      style="display: block; width: 100%; height: 100%;"
    />
  </div>
</div>


{/* Styles */}
<style lang="scss">
  @use './Reveal.scss';
</style>


{/* Script */}
<script>
  // There will always be just one component instance
  // Config
  const revealIdName = 'reveal';
  const fragmentName = '#reveal';
  const showRevealClassName = 'show-reveal';
  const timeBeforeRedirectMs = 650;
  const timeBeforeUrlCheckMs = 1000;


  // Queries
  const revealElement = document.getElementById(revealIdName);
  const siteLinks = document.querySelectorAll('a');


  // Main
  removeFragmentFromUrlAfterDelay();
  addFragmentToLinks(siteLinks, fragmentName);


  // Events
  siteLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();

      if (isLinkedToCurrentPage(link)) {
        return;
      }

      // Show the reveal element
      revealElement?.classList.add(showRevealClassName);

      // Redirect after a delay
      setTimeout(() => {
        window.location.href = link.href;
      }, timeBeforeRedirectMs);
    });
  });


  // Functions
  function isLinkedToCurrentPage(link: HTMLAnchorElement): boolean {
    let currentPageUrl = window.location.href;

    // Remove the fragment from the link href before comparison
    currentPageUrl = currentPageUrl.split('#')[0];
    const linkUrl = link.href.split('#')[0];

    return linkUrl === currentPageUrl;
  }

  function addFragmentToLinks(
    links: NodeListOf<HTMLAnchorElement>,
    fragment: string
  ) {
    links.forEach(link => {
      // Check if link is internal
      if (!link.href.startsWith(window.location.origin)) {
        return;
      }

      // Check if the link is empty
      if (link.href.includes('#')) {
        return;
      }

      link.href += fragment;
    });
  }

  function removeFragmentFromUrlAfterDelay() {
    setTimeout(() => {
      // Check if fragment exists in the URL before removing it
      if (!window.location.href.includes('#')) {
        return;
      }

      window.history.replaceState(null, '', window.location.href.split('#')[0]);
    }, timeBeforeUrlCheckMs);
  }
</script>