---
import Text from '../../ui/text/Text.astro';
import Cell from '../../utils/Cell.astro';
import Grid from '../../utils/Grid.astro';
import SubpageMedia from '../../utils/subpage-media/SubpageMedia.astro';
import type { ContentImage } from '../../utils/Image.astro';
import LineWithContent from '../../utils/lineWithContent/LineWithContent.astro';

/* Props */
interface Props {
  theme?: 'secondary' | 'primary';
  title?: string;
  content?: string;
  image?: ContentImage;
}

const { 
  theme = 'secondary',
  title,
  content,
  image,
} = Astro.props;


/* Computed */
const titleColorClass = theme === 'secondary' ? 'secondary-400' : 'primary-400';
---


{/* Html */}
<section class:list={['text-image']}>
  <Grid lg xs class:list={['ac']}>

    {/* Left */}
    <Cell
      dt={{ start: 1, span: 6 }}
      lg={{ start: 1, span: 7 }}
      xs={{ start: 1, span: 9 }}
    >
      {/* Title */}
      {title && (
        <Text 
          el="h2" type="display-2xl"
          class:list={['-ml-4', titleColorClass]}
          set:html={title}
        />
      )}

      {/* Content */}
      {content && (
        <div class:list={['content', 'mt-md']}>
          <LineWithContent
            theme={theme}
            content={content}
          />
        </div>
      )}
    </Cell>

    {/* Right */}
    <Cell
      dt={{ start: 7, span: 6 }}
      lg={{ start: 8, span: 5 }}
      xs={{ start: 2, span: 10 }}
    >
      {image && (
        <div class:list={['media', 'xs:mt-md']}>
          <SubpageMedia
            theme={theme}
            width={840} height={560}
            src={image.src} alt={image.alt}
          />
        </div>
      )}
    </Cell>
  </Grid>
</section>


{/* Styles */}
<style lang="scss">
  @use './TextImage.scss';
</style>


{/* Script */}
<script>
  
</script>