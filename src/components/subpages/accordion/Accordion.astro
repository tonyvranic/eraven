---
import Text from '../../ui/text/Text.astro';
import AccordioItem from '../../utils/accordion-item/AccordioItem.astro';
import Cell from '../../utils/Cell.astro';
import Flex from '../../utils/Flex.astro';
import Grid from '../../utils/Grid.astro';

/* Props */
interface Props {
  title?: string;
  content?: string;
  items: Array<{ title: string; content: string }>;
  theme: 'primary' | 'secondary';
}

const { 
  title,
  content,
  items = [],
  theme
} = Astro.props;


/* Computed */
const computedTitle = title ?? 'A few<br><em>notes</em>';
---


{/* Html */}
<section class:list={['accordion']}> 
  <Grid lg sm xs>

    {/* Left */}
    <Cell
      dt={{ start: 1, span: 5 }}
      lg={{ start: 1, span: 4 }}
      sm={{ start: 1, span: 11, mb: 'md' }}
      xs={{ start: 1, span: 12 }}
    >

      <div class:list={['sticky']}>
        {/* Title */}
        <Text set:html={computedTitle} el="h2" />

        {/* Content */}
        {content && (
          <div 
            set:html={content}
            class:list={['user-content', 'mt-lg', 'sm:mt-md']}
          />
        )}
      </div>

    </Cell>

    {/* Right - Content */}
    <Cell
      dt={{ start: 6, span: 7 }}
      lg={{ start: 5, span: 8 }}
      sm={{ start: 2, span: 11 }}
      xs={{ start: 1, span: 12 }}
    >
      <Flex
        dt={{ dir: 'column', gap: 'lg' }}
        sm={{ dir: 'column', gap: 'md' }}
      >
        {items.map(item => (
          <AccordioItem
            title={item.title}
            content={item.content}
          />
        ))}
      </Flex>
    </Cell>
  </Grid>
</section>


{/* Styles */}
<style lang="scss">
  @use './Accordion.scss';
</style>


{/* Script */}
<script>
  
</script>