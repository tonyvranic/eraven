---
import Text from '../../ui/text/Text.astro';
import Cell from '../../utils/Cell.astro';
import Grid from '../../utils/Grid.astro';
import SubpageMedia from '../../utils/subpage-media/SubpageMedia.astro';
import type { ContentImage } from '../../utils/Image.astro';
import LineWithContent from '../../utils/lineWithContent/LineWithContent.astro';

/* Props */
interface Props {
  theme?: 'secondary' | 'primary';
  title?: string;
  image?: ContentImage;
  content?: string;
}

const { 
  theme = 'secondary',
  title,
  content,
  image,
} = Astro.props;


/* Computed */
const titleColorClass = theme === 'secondary' ? 'secondary-400' : 'primary-400';
---


{/* Html */}
<section class:list={['image-with-text']}>

  {/* Top */}
  <Grid md sm xxs>
    <Cell
      dt={{ start: 2, span: 5 }}
      md={{ start: 1, span: 6 }}
      sm={{ start: 1, span: 8 }}
      xxs={{ start: 2, span: 11 }}
    >
      {/* Title */}
      {title && (
        <Text 
          el="h2" type="display-2xl"
          class:list={['-mr-4', 'tr', titleColorClass]}
          set:html={title}
        />
      )}
    </Cell>
  </Grid>


  {/* Bottom */}
  <Grid md sm xs xxs class:list={['ac', 'mt-lg', 'xs:mt-md']}>

    {/* Left */}
    <Cell
      dt={{ start: 2, span: 5 }}
      md={{ start: 1, span: 5 }}
      sm={{ start: 1, span: 6 }}
      xs={{ start: 1, span: 8, mb: 'sm' }}
      xxs={{ start: 1, span: 12, mb: 'md' }}
    >
      {image && (
        <div class:list={['media']}>
          <SubpageMedia
            theme={theme} inverted
            width={840} height={560}
            src={image.src} alt={image.alt}
          />
        </div>
      )}
    </Cell>

    {/* Right */}
    <Cell
      dt={{ start: 8, span: 5 }}
      md={{ start: 7, span: 6 }}
      sm={{ start: 7, span: 6 }}
      xs={{ start: 1, span: 11 }}
    >
      {/* Content */}
      {content && (
        <LineWithContent
          theme={theme}
          content={content}
        />
      )}
    </Cell>

  </Grid>

</section>


{/* Styles */}
<style lang="scss">
  @use './ImageWithText.scss';
</style>