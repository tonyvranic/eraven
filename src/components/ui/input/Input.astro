---
import Flex from '../../utils/Flex.astro';
import LabelIconButton from '../../utils/label-icon-button/LabelIconButton.astro';
import Icon from '../icon/Icon.astro';
import type { IconName } from '../icon/Icon.types';
import Text from '../text/Text.astro';

/* Props */
interface Props {
  id: string;
  label?: string;
  type?: 'text' | 'password' | 'email' | 'number';
  value?: string;
  suffix?: string;
  inputAttributes?: Record<string, any>;
  locked?: 'Locked' | 'Unlocked'
  lockedButtonAttributes?: Record<string, any>;
}

const { 
  id,
  label,
  type = "text",
  value = "",
  suffix = "",
  inputAttributes = {},
  locked,
  lockedButtonAttributes = {},
} = Astro.props;


/* Computed */
const disabledInput = locked === 'Locked';
---


{/* Html */}
<div class:list={['input-wrap-outer']}> 
  {label && (
    <Flex
      dt={{ wrap: 'nowrap', align: 'center', justify: 'between' }}
      class:list={['primary-300', 'mb-sm']}
    >
      <Text 
        for={id}
        el="label" type="label-md"
      >
        {label}
      </Text>

      {locked && (
        <LabelIconButton
          label={label}
          locked={locked}
          lockedButtonAttributes={lockedButtonAttributes}
        />
      )} 
    </Flex>
  )}

  <div class:list={['input-wrap', 'rel', 'slice-top-right']}>
    <input 
      id={id} type={type} value={value}
      disabled={disabledInput}
      {...inputAttributes}
    />

    {suffix && (
      <Text 
        el="span" type="display-sm"
        class:list={['suffix', 'abs', 'z-2']}
      >
        {suffix}
      </Text>
    )}
  </div>
</div>


{/* Styles */}
<style lang="scss">
  @use './Input.scss';
</style>


{/* Script */}
<script>
  
</script>