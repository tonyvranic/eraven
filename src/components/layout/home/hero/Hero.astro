---
import Cell from "../../../utils/Cell.astro";
import Flex from "../../../utils/Flex.astro";
import Grid from "../../../utils/Grid.astro";
import Text from "../../../ui/text/Text.astro";
---


{/* Html */}
<section 
  class:list={['hero', 'em-style-secondary', 'bg-primary-600', 'filled-bg']}
  data-home-hero-section
>

  {/* White Text */}
  <div class:list={['hero-wrap-outer-abs', 'abs-fw', 'z-2', 'bg-light-900', 'no-e']} aria-hidden="true">
    <div class:list={['hero-wrap-outer-abs-bg', 'bg-light-900', 'no-e', 'abs', 'z-1']}></div>
    <Grid md sm xs xxs class:list={['fh', 'z-2']}>


      {/* Bg Patterns */}
      {/* Intersection Pattern */}
      <div class:list={['hero-bg-patterns', 'abs', 'fw', 'aspect-1:1', 'z-1', 'pattern-1']}>
        {/* Main Pattern */}
        <div 
          class:list={['hero-bg-pattern', 'abs-fw', 'z-1']}
          style={'background-image: url("/patterns/intersection-pattern.svg");'}
        />

        {/* Hover Pattern */}
        <div class:list={['hero-bg-pattern-mask', 'abs-fw', 'z-2']}>
          <div 
            class:list={['hero-bg-pattern', 'type-hover', 'fh']} 
            style={'background-image: url("/patterns/intersection-pattern-hover.svg");'}
          />
        </div>

        {/* Overlay behind text, to make it more legible */}
        <div class:list={['hero-bg-pattern-overlay', 'abs-fw', 'z-3', 'bg-light-900']} />
      </div>


      {/* Text */}
      <Cell 
        dt={{ start: 1, span: 6 }}
        md={{ start: 2, span: 6 }}
        sm={{ start: 2, span: 7 }}
        xs={{ start: 1, span: 10 }}
        xxs={{ start: 1, span: 12 }}
      >
        <Flex 
          dt={{ dir: 'column', justify: 'center', align: 'center' }} 
          class:list={['hero-wrap', 'type-bg', 'fh', 'rel', 'z-2']}
        >
          <Text el="span" type="display-2xl" class:list={['hero-title', 'tr', 'light-100', 'block', 'fw']}>
            Exploring the <em>intersection</em><br> of creativity<br> & code
          </Text>
        </Flex>
      </Cell>
    </Grid>
  </div>

  {/* Foreground */}
  <Grid md sm xs xxs class:list={['hero-wrap-outer', 'fh',  'rel', 'z-1']}>
    <Cell 
      dt={{ start: 1, span: 6 }}
      md={{ start: 2, span: 6 }}
      sm={{ start: 2, span: 7 }}
      xs={{ start: 1, span: 10 }}
      xxs={{ start: 1, span: 12 }}
      class:list={['relative', 'z-2']}
    >
      <Flex 
        dt={{ dir: 'column', justify: 'center', align: 'center' }} 
        class:list={['hero-wrap', 'fh']}
      >
        <Text el="h1" type="display-2xl" class:list={['hero-title', 'tr', 'light-900', 'fw']}>
          Exploring the <em>intersection</em><br> of creativity<br> & code
        </Text>
      </Flex>
    </Cell>
  </Grid>
</section>


{/* Styles */}
<style lang="scss">
  @use './Hero.scss';
</style>

{/* Script */}
<script>
  import Init from './Hero.ts';

  Init();
</script>