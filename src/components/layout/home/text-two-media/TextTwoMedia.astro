---
import Text from '../../../ui/text/Text.astro';
import Cell from '../../../utils/Cell.astro';
import ColumnMedia from '../../../utils/column-media/ColumnMedia.astro';
import Grid from '../../../utils/Grid.astro';
import Image from '../../../utils/Image.astro';
import MediaBorder from '../../../utils/media-border/MediaBorder.astro';

/* Props */
interface Props {

}

const { 
  /* Destructure your props here */
} = Astro.props;


/* Computed */
---


{/* Html */}
<section class:list={['text-two-media']}>
  <Grid sm xxs>
    {/* Left */}
    <Cell 
      dt={{start: 1, span: 5}}
      sm={{start: 1, span: 9}}
      xxs={{start: 1, span: 11}}
      class:list={['secondary-styling', 'sm:mb-lg']}
    >
      {/* Title */}
      <Text el="h2" type="display-2xl" class:list={['text-two-media-title', 'mb-md', '-ml-4']}>
        The logic of <em>Refraction</em>
      </Text>

      {/* Desc */}
      <Text type="body-lg" class:list={['desc']}>
        Light, once captured, becomes a record.Code provides the structure to understand that record.
        <br><br>
        The visual moment is the beautiful, fleeting accident of reality; the digital process is the act of turning that accident into something permanent and conceptual.
        <br><br>
        This intersection is about exploration. It is about using code not merely to replicate the image, but to dissect it — to give form to memory, to test the boundaries of time, and to find the story hidden within the light
      </Text>
    </Cell>

    {/* Right Media 1 */}
    <Cell 
      dt={{start: 7, span: 3}}
      sm={{start: 1, span: 6}}
      xxs={{start: 1, span: 6}}
    >
      <ColumnMedia
        imageSrc='/imgs/text-two-media/text-two-media-1.webp'
        imageAlt="Light refracting off a prism from white to rainbow colors"
        imageWidth={344}
        imageHeight={548}
        classes={['aspect-2:3']}
      />
    </Cell>

    {/* Right Media 2 */}
    <Cell 
      dt={{start: 10, span: 3}}
      sm={{start: 7, span: 6}}
      xxs={{start: 7, span: 6}}
      class:list={['ase', 'secondary-styling']}
    >
      <ColumnMedia
        imageSrc='/imgs/text-two-media/text-two-media-2.webp'
        imageAlt="Computer screen displaying code"
        imageWidth={344}
        imageHeight={208}
        isSecondary={true}
        classes={['aspect-4:3']}
      />
    </Cell>
  </Grid>
</section>


{/* Styles */}
<style lang="scss">
  @use './TextTwoMedia.scss';
</style>


{/* Script */}
<script>
  
</script>