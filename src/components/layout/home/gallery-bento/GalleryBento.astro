---
import Cell from "../../../utils/Cell.astro";
import Grid from "../../../utils/Grid.astro";
import Text from "../../../ui/text/Text.astro";
import MediaBorder from "../../../utils/media-border/MediaBorder.astro";
import Image from "../../../utils/Image.astro";
import ColumnMedia from "../../../utils/column-media/ColumnMedia.astro";
---


<section class:list={['gallery-bento']}>

  {/* Top */}
  <div class:list={['gallery-bento-top', 'mb-xl', 'md:mb-lg']}>
    <Grid sm xxs>

      {/* Title */}
      <Cell
        dt={{ start: 1, span: 7 }}
        sm={{ start: 3, span: 10 }}
        xxs={{ start: 1, span: 12 }}
        class:list={['sm:mb-sm']}
      >
        <Text el="h2" type="display-3xl" class:list={['tr']}>
          Moments <br>
          <em>in Light</em>
        </Text>
      </Cell>

      {/* Description */}
      <Cell
        dt={{ start: 8, span: 5 }}
        sm={{ start: 1, span: 9 }}
        xxs={{ start: 1, span: 11 }}
        class:list={['ase']}
      >
        <Text el="p" type="body-lg" class:list={['gallery-bento-desc']}>
          We capture moments that are inherently tied to human presence — to a glance, a movement, a shared breath.
          But when the moment is lifted from it's context, and placed here in silence, who is truly left to feel it?
          <br><br>
          Are we honoring the past, <br>
          or merely gazing into a beautiful, empty void?
        </Text>
      </Cell>

    </Grid>
  </div>

  {/* Bottom */}
  <div class:list={['gallery-bento-bottom']}>
    <Grid sm class={'items'} class:list={['ac']}>

      {/* Column 1 */}
      <Cell
        dt={{ start: 1, span: 4 }}
        sm={{ start: 1, span: 12 }}
        class:list={['column']}
      >
        <ColumnMedia
          imageSrc="/imgs/gallery-bento/bento-1.webp"
          imageAlt="Person holding a DSLR camera"
          imageWidth={488}
          imageHeight={1088}
          data-multiplier="4"
          isVertical={true}
        />
      </Cell>

      {/* Column 2 */}
      <Cell
        dt={{ start: 5, span: 4 }}
        sm={{ start: 1, span: 12 }}
        class:list={['column']}
      >
        <ColumnMedia
          imageSrc="/imgs/gallery-bento/bento-2.webp"
          imageAlt="Close up photo of a cat"
          imageWidth={488}
          imageHeight={500}
          data-multiplier="2"
          class:list={['aspect-1:1']}
        />
        <ColumnMedia
          imageSrc="/imgs/gallery-bento/bento-3.webp"
          imageAlt="Empty restaurant"
          imageWidth={488}
          imageHeight={500}
          data-multiplier="2"
          class:list={['aspect-1:1']}
        />
      </Cell>

      {/* Column 3 */}
      <Cell
        dt={{ start: 9, span: 4 }}
        sm={{ start: 1, span: 12 }}
        class:list={['column']}
      >
        <ColumnMedia
          imageSrc="/imgs/gallery-bento/bento-4.webp"
          imageAlt="Park bench covered in autumn leaves"
          imageWidth={488}
          imageHeight={1088}
          data-multiplier="4"
          isVertical={true}
        />
      </Cell>
    </Grid>

  </div>
</section>


{/* Styles */}
<style lang="scss">
  @use './GalleryBento.scss';
</style>